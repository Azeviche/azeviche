+import express from 'express';
+import cors from 'cors';
+import http from 'http';
+import morgan from 'morgan';
+import { WebSocketServer } from 'ws';
+import { Queue } from 'bullmq';
+import { Redis } from 'ioredis';
+import { env } from './config/env.js';
+import { apiRateLimit } from './middleware/rate-limit.js';
+import { authMiddleware } from './middleware/auth.js';
+import { authRouter } from './routes/auth.routes.js';
+import { agentsRouter } from './routes/agents.routes.js';
+import { flowsRouter } from './routes/flows.routes.js';
+import { executionsRouter } from './routes/executions.routes.js';
+import { healthRouter } from './routes/health.routes.js';
+import { eventBus } from './modules/observability/event-bus.js';
+
+const app = express();
+const server = http.createServer(app);
+
+const redis = new Redis(env.redisUrl, { maxRetriesPerRequest: null });
+const executionQueue = new Queue('flow-executions', { connection: redis });
+
+app.use(cors({ origin: env.corsOrigin === '*' ? true : env.corsOrigin }));
+app.use(express.json({ limit: '2mb' }));
+app.use(morgan('dev'));
+app.use(apiRateLimit);
+app.use('/api', authMiddleware);
+
+app.use('/api/health', healthRouter);
+app.use('/api/auth', authRouter);
+app.use('/api/agents', agentsRouter);
+app.use('/api/flows', flowsRouter);
+app.use('/api/executions', executionsRouter);
+
+app.get('/api/openapi.json', (_req, res) => {
+  res.json({
+    openapi: '3.1.0',
+    info: { title: 'Azeviche API', version: '0.1.0' },
+    paths: {
+      '/api/health': { get: { summary: 'Healthcheck' } },
+      '/api/agents': { get: { summary: 'List agents' }, post: { summary: 'Create agent' } },
+      '/api/flows': { get: { summary: 'List flows' }, post: { summary: 'Create flow' } },
+      '/api/executions/run/{flowId}': { post: { summary: 'Run flow DAG' } },
+    },
+  });
+});
+
+const wss = new WebSocketServer({ server, path: '/ws' });
+
+wss.on('connection', (socket) => {
+  socket.send(JSON.stringify({ type: 'connected', message: 'Azeviche WS online' }));
+});
+
+const broadcast = (data: unknown) => {
+  const payload = JSON.stringify(data);
+  wss.clients.forEach((client) => {
+    if (client.readyState === 1) client.send(payload);
+  });
+};
+
+eventBus.on('execution:update', (payload) => broadcast({ type: 'execution:update', payload }));
+eventBus.on('execution:done', (payload) => broadcast({ type: 'execution:done', payload }));
+eventBus.on('execution:failed', (payload) => broadcast({ type: 'execution:failed', payload }));
+
+server.listen(env.port, async () => {
+  await executionQueue.waitUntilReady();
+  console.log(`API listening on http://localhost:${env.port}`);
+});

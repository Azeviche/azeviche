@@ -0,0 +1,42 @@
+import { FlowNode } from '../../types/domain.js';
+
+export const executeNodeByType = async (
+  node: FlowNode,
+  inputs: Record<string, unknown>,
+): Promise<{ output: unknown; tokenUsage: number }> => {
+  switch (node.type) {
+    case 'trigger.http':
+    case 'trigger.schedule':
+      return { output: { trigger: true, at: new Date().toISOString() }, tokenUsage: 0 };
+    case 'agent':
+      return {
+        output: {
+          response: `Agent ${node.name} executou com contexto`,
+          context: inputs,
+        },
+        tokenUsage: 320,
+      };
+    case 'condition': {
+      const isTrue = Boolean((node.config as { expression?: boolean }).expression ?? true);
+      return { output: { pass: isTrue, inputs }, tokenUsage: 4 };
+    }
+    case 'api_request':
+      return { output: { status: 200, body: { mocked: true } }, tokenUsage: 12 };
+    case 'database':
+      return { output: { rows: [{ id: 1, result: 'ok' }] }, tokenUsage: 3 };
+    case 'memory':
+      return { output: { memoryRef: 'session-memory', saved: true }, tokenUsage: 2 };
+    case 'python':
+      return {
+        output: {
+          sandbox: 'placeholder',
+          result: 'Python execution simulated securely',
+        },
+        tokenUsage: 6,
+      };
+    case 'output':
+      return { output: { final: inputs }, tokenUsage: 0 };
+    default:
+      return { output: { unknown: true }, tokenUsage: 0 };
+  }
+};

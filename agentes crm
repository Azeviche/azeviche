+          onNodesChange={onNodesChange}
+          onEdgesChange={onEdgesChange}
+          onConnect={onConnect}
+          fitView
+          className="rounded-xl"
+        >
+          <MiniMap />
+          <Controls />
+          <Background />
+        </ReactFlow>
+      </article>

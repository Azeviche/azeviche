+import { NextFunction, Request, Response } from 'express';
+import jwt from 'jsonwebtoken';
+import { env } from '../config/env.js';
+
+export interface AuthedRequest extends Request {
+  user?: { sub: string; role: string };
+}
+
+export const authMiddleware = (req: AuthedRequest, res: Response, next: NextFunction) => {
+  if (req.path.startsWith('/health') || req.path.startsWith('/auth/token')) {
+    return next();
+  }
+
+  const authHeader = req.headers.authorization;
+  if (!authHeader?.startsWith('Bearer ')) {
+    return res.status(401).json({ error: 'Missing bearer token' });
+  }
+
+  const token = authHeader.replace('Bearer ', '');
+
+  try {
+    req.user = jwt.verify(token, env.jwtSecret) as { sub: string; role: string };
+    return next();
+  } catch {
+    return res.status(401).json({ error: 'Invalid token' });
+  }
+};

+import crypto from 'node:crypto';
+import { env } from '../../config/env.js';
+import { eventBus } from '../observability/event-bus.js';
+import { logger } from '../observability/logger.js';
+import { Flow, ExecutionRecord, ExecutionNodeResult } from '../../types/domain.js';
+import { getTopologicalOrder } from './dag.js';
+import { executeNodeByType } from './node.executor.js';
+
+const executions: ExecutionRecord[] = [];
+
+const withTimeout = async <T>(promise: Promise<T>, ms: number): Promise<T> => {
+  return await Promise.race([
+    promise,
+    new Promise<T>((_, reject) => setTimeout(() => reject(new Error('Node timeout exceeded')), ms)),
+  ]);
+};
+
+export const executionService = {
+  list: () => executions,
+  run: async (flow: Flow) => {
+    const execution: ExecutionRecord = {
+      id: crypto.randomUUID(),
+      flowId: flow.id,
+      status: 'running',
+      startedAt: Date.now(),
+      nodeResults: [],
+    };
+    executions.unshift(execution);
+
+    const outputsByNode = new Map<string, unknown>();
+
+    try {
+      const order = getTopologicalOrder(flow);
+      for (const nodeId of order) {
+        const node = flow.nodes.find((item) => item.id === nodeId);
+        if (!node) continue;
+
+        const parents = flow.edges.filter((edge) => edge.target === nodeId).map((edge) => edge.source);
+        const input = Object.fromEntries(parents.map((parentId) => [parentId, outputsByNode.get(parentId)]));
+
+        const result: ExecutionNodeResult = {
+          nodeId: node.id,
+          status: 'failed',
+          startedAt: Date.now(),
+          endedAt: Date.now(),
+        };
+
+        let attempt = 0;
+        while (attempt <= env.nodeRetries) {
+          try {
+            const nodeOutput = await withTimeout(executeNodeByType(node, input), env.nodeTimeoutMs);
+            result.status = 'success';
+            result.output = nodeOutput.output;
+            result.tokenUsage = nodeOutput.tokenUsage;
+            outputsByNode.set(node.id, nodeOutput.output);
+            break;
+          } catch (error) {
+            attempt += 1;
+            result.error = (error as Error).message;
+            if (attempt > env.nodeRetries) {
+              throw error;
+            }
+          }
+        }
+
+        result.endedAt = Date.now();
+        execution.nodeResults.push(result);
+        eventBus.emit('execution:update', { executionId: execution.id, result });
+      }
+
+      execution.status = 'success';
+      execution.endedAt = Date.now();
+      logger.info('Execution finished', execution);
+      eventBus.emit('execution:done', execution);
+      return execution;
+    } catch (error) {
+      execution.status = 'failed';
+      execution.endedAt = Date.now();
+      logger.error('Execution failed', { error: (error as Error).message, execution });
+      eventBus.emit('execution:failed', execution);
+      return execution;
+    }
+  },
+};

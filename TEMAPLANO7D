@@ -0,0 +1,214 @@
+:root {
+  --plano7d-bg: #0a0a0d;
+  --plano7d-surface: #15161a;
+  --plano7d-surface-alt: #1c1d24;
+  --plano7d-text: #f5f5f7;
+  --plano7d-muted: #c5c5d0;
+  --plano7d-accent: #e50914;
+  --plano7d-accent-secondary: #5ac8fa;
+  --plano7d-radius: 18px;
+  --plano7d-radius-pill: 999px;
+  --plano7d-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body.plano7d-premium {
+  margin: 0;
+  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  color: var(--plano7d-text);
+  background: radial-gradient(circle at 20% -20%, #262a34 0%, var(--plano7d-bg) 50%);
+}
+
+.plano7d-container {
+  width: min(1180px, 92vw);
+  margin: 0 auto;
+}
+
+.plano7d-site-header {
+  position: sticky;
+  top: 0;
+  z-index: 100;
+  backdrop-filter: blur(16px);
+  background: rgba(10, 10, 13, 0.65);
+  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.plano7d-header-inner {
+  display: flex;
+  gap: 1.5rem;
+  align-items: center;
+  justify-content: space-between;
+  min-height: 74px;
+}
+
+.plano7d-logo {
+  color: var(--plano7d-text);
+  font-weight: 700;
+  text-decoration: none;
+}
+
+.plano7d-main-nav .plano7d-menu {
+  display: flex;
+  gap: 1rem;
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.plano7d-main-nav .plano7d-menu a {
+  color: var(--plano7d-muted);
+  text-decoration: none;
+  font-size: 0.95rem;
+}
+
+.plano7d-cta,
+.plano7d-button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: var(--plano7d-radius-pill);
+  text-decoration: none;
+  transition: transform 0.2s ease, opacity 0.2s ease;
+}
+
+.plano7d-cta {
+  background: linear-gradient(130deg, var(--plano7d-accent) 0%, #ff4d4d 100%);
+  color: #fff;
+  padding: 0.7rem 1.2rem;
+  font-weight: 600;
+}
+
+.plano7d-cta:hover,
+.plano7d-button:hover {
+  transform: translateY(-1px);
+  opacity: 0.92;
+}
+
+.plano7d-hero {
+  position: relative;
+  min-height: 72vh;
+  display: grid;
+  place-items: center;
+  background: linear-gradient(140deg, rgba(8, 8, 11, 0.88), rgba(8, 8, 11, 0.35)),
+    url('https://images.unsplash.com/photo-1516589091380-5d601fa7a5f4?auto=format&fit=crop&w=1400&q=80') center/cover;
+}
+
+.plano7d-overlay {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(to top, rgba(10, 10, 13, 0.95), rgba(10, 10, 13, 0.35));
+}
+
+.plano7d-hero-inner {
+  position: relative;
+  z-index: 1;
+  text-align: left;
+  padding: 5rem 0;
+}
+
+.plano7d-kicker {
+  display: inline-block;
+  padding: 0.35rem 0.8rem;
+  border-radius: var(--plano7d-radius-pill);
+  border: 1px solid rgba(255, 255, 255, 0.2);
+  font-size: 0.82rem;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.plano7d-hero h1 {
+  font-size: clamp(2rem, 6vw, 4rem);
+  margin: 1rem 0;
+  line-height: 1.08;
+  max-width: 14ch;
+}
+
+.plano7d-hero p {
+  max-width: 60ch;
+  color: var(--plano7d-muted);
+}
+
+.plano7d-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.8rem;
+  margin-top: 1.6rem;
+}
+
+.plano7d-button {
+  padding: 0.85rem 1.25rem;
+  font-weight: 600;
+}
+
+.plano7d-button-primary {
+  color: #fff;
+  background: var(--plano7d-accent);
+}
+
+.plano7d-button-ghost {
+  color: var(--plano7d-text);
+  border: 1px solid rgba(255, 255, 255, 0.22);
+}
+
+.plano7d-section {
+  padding: clamp(3rem, 7vw, 5rem) 0;
+}
+
+.plano7d-section h2 {
+  font-size: clamp(1.5rem, 4vw, 2.4rem);
+  margin: 0 0 1.5rem;
+}
+
+.plano7d-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 1rem;
+}
+
+.plano7d-card {
+  background: linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  border-radius: var(--plano7d-radius);
+  box-shadow: var(--plano7d-shadow);
+  padding: 1.2rem;
+}
+
+.plano7d-module-card {
+  min-height: 180px;
+}
+
+.plano7d-card p,
+.plano7d-card blockquote,
+.plano7d-content {
+  color: var(--plano7d-muted);
+}
+
+.plano7d-section-dark {
+  background: #070709;
+}
+
+.plano7d-site-footer {
+  border-top: 1px solid rgba(255, 255, 255, 0.08);
+  padding: 2rem 0;
+}
+
+.plano7d-footer-menu {
+  list-style: none;
+  display: flex;
+  gap: 1rem;
+  padding: 0;
+}
+
+.plano7d-footer-menu a {
+  color: var(--plano7d-muted);
+  text-decoration: none;
+}
+
+@media (max-width: 820px) {
+  .plano7d-main-nav {
+    display: none;
+  }
+}

@@ -0,0 +1,16 @@
+(() => {
+  const cards = document.querySelectorAll('.plano7d-card');
+
+  cards.forEach((card) => {
+    card.addEventListener('mousemove', (event) => {
+      const rect = card.getBoundingClientRect();
+      const x = ((event.clientX - rect.left) / rect.width) * 100;
+      const y = ((event.clientY - rect.top) / rect.height) * 100;
+      card.style.background = `radial-gradient(circle at ${x}% ${y}%, rgba(90, 200, 250, 0.22), rgba(255,255,255,0.04) 40%, rgba(255,255,255,0.02) 80%)`;
+    });
+
+    card.addEventListener('mouseleave', () => {
+      card.style.background = 'linear-gradient(145deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02))';
+    });
+  });
+})();

diff --git a/functions.php b/functions.php
new file mode 100644
index 0000000000000000000000000000000000000000..2658653263d69a73760ec15f7eb4bca10dd350d3
--- /dev/null
+++ b/functions.php
@@ -0,0 +1,91 @@
+<?php
+/**
+ * Funções do tema Plano 7D Care.
+ *
+ * @package Plano7DCare
+ */
+
+if (! defined('ABSPATH')) {
+    exit;
+}
+
+/**
+ * Setup do tema.
+ */
+function plano7d_setup(): void
+{
+    add_theme_support('title-tag');
+    add_theme_support('post-thumbnails');
+    add_theme_support('html5', ['search-form', 'comment-form', 'comment-list', 'gallery', 'caption', 'style', 'script']);
+    add_theme_support('custom-logo', [
+        'height'      => 80,
+        'width'       => 280,
+        'flex-height' => true,
+        'flex-width'  => true,
+    ]);
+    add_theme_support('editor-styles');
+    add_editor_style('assets/css/theme.css');
+
+    register_nav_menus([
+        'primary' => __('Menu Principal', 'plano-7d-care'),
+        'footer'  => __('Menu Rodapé', 'plano-7d-care'),
+    ]);
+}
+add_action('after_setup_theme', 'plano7d_setup');
+
+/**
+ * Enfileira assets.
+ */
+function plano7d_enqueue_assets(): void
+{
+    $theme = wp_get_theme();
+
+    wp_enqueue_style(
+        'plano7d-google-fonts',
+        'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap',
+        [],
+        null
+    );
+
+    wp_enqueue_style(
+        'plano7d-theme',
+        get_theme_file_uri('assets/css/theme.css'),
+        ['plano7d-google-fonts'],
+        $theme->get('Version')
+    );
+
+    wp_enqueue_script(
+        'plano7d-theme',
+        get_theme_file_uri('assets/js/theme.js'),
+        [],
+        $theme->get('Version'),
+        true
+    );
+}
+add_action('wp_enqueue_scripts', 'plano7d_enqueue_assets');
+
+/**
+ * Body classes utilitárias.
+ */
+function plano7d_body_classes(array $classes): array
+{
+    $classes[] = 'plano7d-premium';
+
+    if (is_front_page()) {
+        $classes[] = 'plano7d-front';
+    }
+
+    return $classes;
+}
+add_filter('body_class', 'plano7d_body_classes');
+
+/**
+ * Mensagem no admin para orientar uso com Elementor.
+ */
+function plano7d_admin_notice_elementor(): void
+{
+    if (current_user_can('activate_plugins') && ! did_action('elementor/loaded')) {
+        echo '<div class="notice notice-warning"><p>' . esc_html__('Plano 7D Care funciona melhor com Elementor ativado.', 'plano-7d-care') . '</p></div>';
+    }
+}
+add_action('admin_notices', 'plano7d_admin_notice_elementor');
